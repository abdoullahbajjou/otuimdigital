{
  "name": "otium-site",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "check": "node build.mjs && node tools/check.mjs",
    "check:live": "node tools/check-live.mjs",
    "dev": "node build.mjs && wrangler dev --port 8787",
    "deploy": "node build.mjs && node --test \"tests/*.test.mjs\" && node tools/check.mjs && wrangler deploy && node tools/check-live.mjs"
  },
  "devDependencies": { "wrangler": "^4.160.1" }
}
